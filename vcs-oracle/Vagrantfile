# -*- mode: ruby -*-
# vi: set ft=ruby :

# Two-node Veritas InfoScale (VCS) cluster running Oracle 19c on shared storage
# exported by an LIO iSCSI target, built with Vagrant and libvirt/QEMU.
#
# Prerequisites, installer media placement and usage are described in README.md.

require "fileutils"

LAB_DIR           = File.expand_path(__dir__)
BOX               = ENV.fetch("VCS_LAB_BOX", "generic/oracle8")
CLUSTER_NAME      = ENV.fetch("VCS_LAB_CLUSTER", "vcsoracle")
CLUSTER_ID        = ENV.fetch("VCS_LAB_CLUSTER_ID", "13221")
ORACLE_SID        = ENV.fetch("VCS_LAB_SID", "orcl")
SERVICE_IP        = ENV.fetch("VCS_LAB_SERVICE_IP", "10.10.3.100")
SHARED_DISK_MB    = Integer(ENV.fetch("VCS_LAB_SHARED_MB", "8192"))
COORD_DISK_MB     = Integer(ENV.fetch("VCS_LAB_COORD_MB", "1024"))
INFOSCALE_PRODUCT = ENV.fetch("VCS_LAB_INFOSCALE_PRODUCT", "")
STORAGE_IP        = ENV.fetch("VCS_LAB_STORAGE_IP", "10.10.3.1")
STORAGE_IQN       = ENV.fetch("VCS_LAB_ISCSI_IQN", "iqn.2026-11.lab.vcs:storage")

# Both nodes use the same root key pair so that the InfoScale installer and the
# cluster tools can reach the peer without a password. It is generated here on
# the host and copied into the guests by the file provisioner.
LAB_ROOT_KEY = File.join(LAB_DIR, ".runtime", "lab_root_key")
unless File.exist?(LAB_ROOT_KEY)
  FileUtils.mkdir_p(File.dirname(LAB_ROOT_KEY), mode: 0o700)
  ok = system("ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "vcs-lab-root", "-f", LAB_ROOT_KEY)
  raise "could not generate #{LAB_ROOT_KEY}" unless ok
end

# Adapter 1 is the libvirt management network (DHCP, used by Vagrant). The three
# lab networks are static and configured by 01-base.sh through NetworkManager,
# so each of them gets a fixed MAC address that both the host and the guest can
# map back to a role.
NODES = [
  {
    name: "vcs1", role: "primary",
    client_ip: "10.10.3.11", client_mac: "525400AA0311",
    llt1_ip: "10.10.1.11",   llt1_mac: "525400AA0111",
    llt2_ip: "10.10.2.11",   llt2_mac: "525400AA0211",
  },
  {
    name: "vcs2", role: "secondary",
    client_ip: "10.10.3.12", client_mac: "525400AA0312",
    llt1_ip: "10.10.1.12",   llt1_mac: "525400AA0112",
    llt2_ip: "10.10.2.12",   llt2_mac: "525400AA0212",
  },
].freeze

def mac_with_colons(mac)
  mac.scan(/../).join(":")
end

def lab_env(node, peer)
  {
    "LAB_NODE"              => node[:name],
    "LAB_ROLE"              => node[:role],
    "LAB_PEER"              => peer[:name],
    "LAB_CLUSTER_NAME"      => CLUSTER_NAME,
    "LAB_CLUSTER_ID"        => CLUSTER_ID,
    "LAB_ORACLE_SID"        => ORACLE_SID,
    "LAB_CLIENT_IP"         => node[:client_ip],
    "LAB_PEER_CLIENT_IP"    => peer[:client_ip],
    "LAB_LLT1_IP"           => node[:llt1_ip],
    "LAB_LLT2_IP"           => node[:llt2_ip],
    "LAB_PEER_LLT1_IP"      => peer[:llt1_ip],
    "LAB_PEER_LLT2_IP"      => peer[:llt2_ip],
    "LAB_CLIENT_MAC"        => mac_with_colons(node[:client_mac]),
    "LAB_LLT1_MAC"          => mac_with_colons(node[:llt1_mac]),
    "LAB_LLT2_MAC"          => mac_with_colons(node[:llt2_mac]),
    "LAB_SERVICE_IP"        => SERVICE_IP,
    "LAB_SHARED_DISK_MB"    => SHARED_DISK_MB.to_s,
    "LAB_COORD_DISK_MB"     => COORD_DISK_MB.to_s,
    "LAB_INFOSCALE_PRODUCT" => INFOSCALE_PRODUCT,
    "LAB_STORAGE_IP"        => STORAGE_IP,
    "LAB_STORAGE_IQN"       => STORAGE_IQN,
  }
end

Vagrant.configure("2") do |config|
  config.vm.box = BOX
  config.vm.boot_timeout = 900
  # Everything the guest needs is uploaded with the file provisioner, so no
  # rsync/NFS/9p shared folder is required (the oracle8 kernel has no 9p).
  config.vm.synced_folder ".", "/vagrant", disabled: true

  media = Dir.glob(File.join(LAB_DIR, "software", "*"))
             .reject { |f| File.basename(f) =~ /\A(README\.md|\.gitignore)\z/ }

  NODES.each do |node|
    peer = NODES.find { |n| n[:name] != node[:name] }

    config.vm.define node[:name] do |machine|
      machine.vm.hostname = node[:name]

      # Isolated layer-2 segments; LLT only needs raw ethernet between the two
      # nodes. The client segment also carries the floating service address.
      machine.vm.network "private_network",
        ip: node[:llt1_ip], mac: node[:llt1_mac], auto_config: false,
        libvirt__network_name: "vcs-llt1",
        libvirt__host_ip: "10.10.1.1",
        libvirt__forward_mode: "none",
        libvirt__dhcp_enabled: false,
        bridge_stp: false
      machine.vm.network "private_network",
        ip: node[:llt2_ip], mac: node[:llt2_mac], auto_config: false,
        libvirt__network_name: "vcs-llt2",
        libvirt__host_ip: "10.10.2.1",
        libvirt__forward_mode: "none",
        libvirt__dhcp_enabled: false,
        bridge_stp: false
      machine.vm.network "private_network",
        ip: node[:client_ip], mac: node[:client_mac], auto_config: false,
        libvirt__network_name: "vcs-client",
        libvirt__host_ip: "10.10.3.1",
        libvirt__forward_mode: "none",
        libvirt__dhcp_enabled: false,
        bridge_stp: false

      machine.vm.provider :libvirt do |lv|
        lv.driver = "kvm"
        lv.memory = 4096
        lv.cpus = 2
        lv.graphics_type = "none"
        lv.video_type = "vga"
        lv.disk_bus = "virtio"
        lv.nic_model_type = "virtio"
      end

      # Scripts and templates are copied to the guest; media is only uploaded
      # when it exists in software/ (the Oracle zip alone is ~3 GB).
      machine.vm.provision "lab-scripts", type: "file",
        source: "scripts", destination: "/home/vagrant/vcs-lab/scripts"
      machine.vm.provision "lab-templates", type: "file",
        source: "files", destination: "/home/vagrant/vcs-lab/files"
      unless media.empty?
        machine.vm.provision "lab-media", type: "file",
          source: "software", destination: "/home/vagrant/vcs-lab/software"
      end
      machine.vm.provision "lab-key", type: "file",
        source: LAB_ROOT_KEY, destination: "/home/vagrant/vcs-lab/lab_root_key"

      env = lab_env(node, peer)

      machine.vm.provision "base", type: "shell",
        inline: "bash /home/vagrant/vcs-lab/scripts/01-base.sh", env: env
      machine.vm.provision "storage", type: "shell",
        inline: "bash /home/vagrant/vcs-lab/scripts/02-shared-storage.sh", env: env
      machine.vm.provision "oracle_prereq", type: "shell",
        inline: "bash /home/vagrant/vcs-lab/scripts/03-oracle-prereq.sh", env: env
      machine.vm.provision "oracle_install", type: "shell",
        inline: "bash /home/vagrant/vcs-lab/scripts/04-oracle-install.sh", env: env
      machine.vm.provision "oracle_database", type: "shell",
        inline: "bash /home/vagrant/vcs-lab/scripts/05-oracle-database.sh", env: env
      machine.vm.provision "vcs_install", type: "shell",
        inline: "bash /home/vagrant/vcs-lab/scripts/06-vcs-install.sh", env: env
      # Cluster creation needs both nodes up, so it is not part of `vagrant up`.
      # Run ./lab cluster once both machines are running.
      machine.vm.provision "vcs_config", type: "shell",
        inline: "bash /home/vagrant/vcs-lab/scripts/07-vcs-config.sh",
        env: env, run: "never"
      machine.vm.provision "status", type: "shell",
        inline: "bash /home/vagrant/vcs-lab/scripts/08-status.sh",
        env: env, run: "never"
    end
  end
end
